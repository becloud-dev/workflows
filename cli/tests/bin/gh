#!/usr/bin/env bash
# Stub `gh` for the CLI's tests. A test copies it into a scratch directory with one answer per API
# path: the path with `/ ? & =` turned into `_`, plus `.json`. A path with no answer fails as
# GitHub's 404 does. Every call is appended to calls.log; a call without --paginate --slurp fails.
set -u
dir=$(cd "$(dirname "$0")" && pwd)
printf '%s\n' "$*" >> "$dir/calls.log"
[ "${1:-}" = api ] || { echo "stub gh: only 'gh api' is answered" >&2; exit 2; }
case " $* " in *" --paginate "*) ;; *) echo "stub gh: --paginate missing" >&2; exit 2 ;; esac
case " $* " in *" --slurp "*) ;; *) echo "stub gh: --slurp missing" >&2; exit 2 ;; esac
path=
for a in "$@"; do case $a in repos/*) path=$a ;; esac; done
key=$(printf '%s' "$path" | tr '/?&=' '____')
[ -f "$dir/$key.json" ] || { echo "gh: Not Found (HTTP 404)" >&2; exit 1; }
cat "$dir/$key.json"
